# Copy to `api.env` at the REPO ROOT and fill in. Every module resolves this one file from
# __file__, so it loads no matter which directory you run from.
#
#   cp api.env.example api.env
#
# `api.env` is gitignored. This example file is not — keep real keys out of it.

# --- Agent runtime: UCL vLLM server (Qwen/Qwen3.6-27B) ---------------------------
# Required for anything that drives the agent. Retired OpenRouter for agent calls
# (2026-07-19 user directive) when its credits ran out.
# UCL_BASE_URL is a BARE HOST — the code appends :8000/v1 itself. No scheme, no port.
# The server 401s without a bearer key (measured 2026-07-19).
UCL_BASE_URL=
UCL_API=

# --- Unity sim -------------------------------------------------------------------
# The sim's WebSocket command server. Currently a hardcoded default in ~20 places
# (both env.py copies, md_tools.py, and the --uri default of every slamtest script);
# set it here only once those read it. Overridable per-run today via --uri.
# SARI_WS_URI=ws://localhost:8080/commands

# --- Third-party -----------------------------------------------------------------
# Moondream cloud API — the agent runtime's only non-self-hosted dependency.
# Used by md_tools.py and perception.py.
MDREAM_API_KEY=

# Gemini — legacy root stack (functions.py, comprehension.py).
GEMINI_API_KEY=

# OpenRouter — LEGACY. Credits exhausted (402); agent calls moved to the UCL server.
# Still read by agent.py's OpenRouterConfig default and subagent_run.py.
OPENROUTER_API_KEY=

# Replicate — no reader found anywhere in the codebase. Present in the original
# api.env; safe to drop unless something outside this repo uses it.
REPLICATE_API_TOKEN=

# --- Legacy root stack -----------------------------------------------------------
# The LitServe inference server that run.py posts to. Hardcoded at run.py:10 today.
# SARI_SERVER_URL=http://localhost:8005/predict
